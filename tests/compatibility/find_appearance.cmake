file(MAKE_DIRECTORY "${OUT}")
foreach(language IN ITEMS en-US zh-CN)
set(ENV{CLIPROPE_PROBE_UI_LANGUAGE} "${language}")
foreach(dpi IN ITEMS 96 120 144 192)
    foreach(theme IN ITEMS light dark contrast)
        set(ENV{CLIPROPE_PROBE_UI_DPI} "${dpi}")
        set(ENV{CLIPROPE_PROBE_UI_THEME} "${theme}")
        execute_process(COMMAND "${PROBE}" "${OUT}/${language}-${theme}-${dpi}.bmp" "${dpi}" COMMAND_ERROR_IS_FATAL ANY)
    endforeach()
endforeach()
endforeach()

if(NOT DEFINED CLIPROPE_LAYOUT_OUTPUT OR NOT IS_ABSOLUTE "${CLIPROPE_LAYOUT_OUTPUT}")
    message(FATAL_ERROR "An absolute direct-build marker path is required")
endif()
get_filename_component(layout_name "${CLIPROPE_LAYOUT_OUTPUT}" NAME)
if(NOT layout_name STREQUAL "ClipRope.build.ini")
    message(FATAL_ERROR "Unexpected direct-build marker name")
endif()
get_filename_component(layout_directory "${CLIPROPE_LAYOUT_OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${layout_directory}")
set(layout "[ClipRope]\nLayout=direct-build-v1\nVersion=${CLIPROPE_LAYOUT_VERSION}\nUsage=development\n")
if(EXISTS "${CLIPROPE_LAYOUT_OUTPUT}")
    file(READ "${CLIPROPE_LAYOUT_OUTPUT}" previous_layout)
endif()
if(NOT previous_layout STREQUAL layout)
    file(WRITE "${CLIPROPE_LAYOUT_OUTPUT}" "${layout}")
endif()
